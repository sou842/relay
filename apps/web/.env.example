# Copy to .env.local for development. On Vercel, add these under Project Settings -> Environment Variables.

# MongoDB (users, sessions, instance ownership). Atlas must allow connections from Vercel (Network Access).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=relay

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this site, e.g. https://relay.example.com (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Other URLs the site is served from (aliases, custom domains), comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=

# Error tracker (optional): browser errors and performance go to your dashboard. The key is public by
# design (it ships to the browser). Leave it unset in development to keep local noise out.
# NEXT_PUBLIC_ values are baked in at build time, so set it before the Vercel build.
NEXT_PUBLIC_ERROR_TRACKER_KEY=
# NEXT_PUBLIC_ERROR_TRACKER_ENDPOINT=https://monitoringsystem-backend.vercel.app/api/v1/events

# Gateway (server-side only; never exposed to the browser). Must be reachable from the internet over HTTPS in production.
GATEWAY_URL=http://127.0.0.1:7700
GATEWAY_ADMIN_KEY=
